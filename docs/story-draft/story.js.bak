/** 剧情档案的 HTML（主界面与战场的「剧情」按钮共用）：顶部目录 + 分章正文。 */
export function storyHtml() {
  const toc = STORY.map(chapter => `<button type="button" data-story-jump="${chapter.id}">${chapter.title}</button>`).join('');
  const chapters = STORY.map(chapter => `<article id="story-${chapter.id}"><b>${chapter.title}</b><small class="story-range">${chapter.chapters}</small>${chapter.paragraphs.map(text => `<p>${text}</p>`).join('')}</article>`).join('');
  return `<p class="dialog-lead">${STORY_NOTE}</p><nav class="story-toc" aria-label="章节目录">${toc}</nav><div class="story-list">${chapters}</div>`;
}

/** 章节数、话数跨度与总字数，供测试与自检使用。 */
export function storyStats() {
  return {
    chapters: STORY.length,
    characters: STORY.reduce((sum, chapter) => sum + chapter.paragraphs.join('').length, 0),
    range: `${STORY[0].chapters.match(/\d+/)[0]}–${STORY.at(-1).chapters.match(/第 (\d+)–(\d+)/)[2]}`,
  };
}
